# =============================================================================
# Sagip — client-frontend (.env.example)
# Copy to .env.local (or .env) in this directory:
#   cp .env.example .env.local
#
# UI runs on http://localhost:8000
# All secrets (DB, JWT, Stellar, SMTP, …) live in server-backend/.env
# =============================================================================

# -----------------------------------------------------------------------------
# API proxy (proxy.ts)
# -----------------------------------------------------------------------------
# Backend origin for server-side /api rewrites. The browser never calls this
# URL directly — it uses same-origin /api/* so CORS is not needed in dev.
#
# Dev default (omit this line):  http://localhost:8001
# Production (required):         https://api.yourdomain.com
#
# API_URL="http://localhost:8001"
# API_URL="https://api.yourdomain.com"

# -----------------------------------------------------------------------------
# Visitor IP forwarding (recommended in production)
# -----------------------------------------------------------------------------
# Every visitor reaches the API through this proxy, so without this the API
# sees one caller IP and per-visitor rate limits become shared. Set the same
# random value here and in server-backend PROXY_SHARED_SECRET.
# On Vercel the visitor IP comes from the platform's X-Forwarded-For. Elsewhere,
# run this app behind one reverse proxy (nginx, a load balancer) that appends the
# visitor IP: only the last X-Forwarded-For entry is trusted.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# PROXY_SHARED_SECRET="change-me-proxy-secret"
